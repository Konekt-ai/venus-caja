# ============================================================
#  VENUS CAJA - configuracion de la instalacion
#  Copia este archivo como  .env.local  y ajusta los valores.
#  INSTALAR.bat lo hace solo la primera vez.
# ============================================================

# Ruta ABSOLUTA a la base de datos del sistema de bodega.
# Es la misma base: la caja no tiene una propia. Asi la bodega ve las
# ventas del dia en el momento y el inventario se descuenta de verdad.
# Ojo: se escribe con diagonales normales, aunque sea Windows.
VENUS_DB=C:/Venus/venus-gestion/data/venus.db

# Llave para firmar la sesion de las vendedoras. INSTALAR.bat genera una
# al azar. Si se cambia, todas las sesiones abiertas se cierran.
VENUS_LLAVE_SESION=cambiame-por-una-llave-larga-al-azar

# Contrasena del duenio para entrar a Reportes, Productos y Ajustes.
# Las vendedoras entran con su PIN; esta es aparte.
VENUS_PIN_DUENIO=1234

# Nombre de la caja. Sale en el ticket y en el folio (C1-000123).
# Si algun dia hay dos cajas, la segunda se llama C2 y no chocan los folios.
VENUS_CAJA=C1
